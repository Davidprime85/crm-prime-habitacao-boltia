# Supabase Configuration
# Obtenha essas credenciais em: https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Edge Functions Secrets
# Configure estas secrets no painel do Supabase:
# Edge Functions → Secrets

# OPENAI_API_KEY=sk-proj-your-openai-key-here
# RESEND_API_KEY=re_your-resend-key-here

# Nota: As secrets das Edge Functions NÃO devem estar no .env
# Elas são configuradas diretamente no Supabase Dashboard
